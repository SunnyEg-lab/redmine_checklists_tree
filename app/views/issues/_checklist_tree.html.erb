<% if !@issue.blank? && @issue.checklist_trees.any? && User.current.allowed_to?(:view_checklists_tree, @project) %>
<hr />
<div id="checklist-tree">
  <p>
    <strong><%= l(:label_checklist_tree_plural) %></strong>
  </p>

  <ul id="checklist_tree_items">
    <% parents    = @issue.checklist_trees.select { |i| i.parent_id.nil? } %>
    <% children_h = @issue.checklist_trees.select { |i| i.parent_id.present? }.group_by(&:parent_id) %>

    <% parents.each do |item| %>
      <% kids = children_h[item.id] || [] %>
      <%# 親アイテムを li として直接生成（li の中に li を避けるため partial を使わない） %>
      <li id="clt_item_<%= item.id %>"
          class="clt-item <%= 'is-done' if item.is_done %>"
          data-id="<%= item.id %>"
          data-parent-id="">
        <%= check_box_tag 'checklist_tree_item', '', item.is_done,
              disabled: !User.current.allowed_to?(:done_checklists_tree, item.issue.project),
              data: { url: done_checklist_tree_path(item) },
              class: 'clt-checkbox',
              id: "clt-checkbox-#{item.id}" %>
        <span class="clt-subject <%= 'is-done' if item.is_done %>">
          <%= item.subject %>
        </span>
        <% if kids.any? %>
        <ul class="clt-children-list" data-parent-id="<%= item.id %>">
          <% kids.each do |child| %>
            <li id="clt_item_<%= child.id %>"
                class="clt-item <%= 'is-done' if child.is_done %>"
                data-id="<%= child.id %>"
                data-parent-id="<%= item.id %>">
              <%= check_box_tag 'checklist_tree_item', '', child.is_done,
                    disabled: !User.current.allowed_to?(:done_checklists_tree, child.issue.project),
                    data: { url: done_checklist_tree_path(child) },
                    class: 'clt-checkbox',
                    id: "clt-checkbox-#{child.id}" %>
              <span class="clt-subject <%= 'is-done' if child.is_done %>">
                <%= child.subject %>
              </span>
            </li>
          <% end %>
        </ul>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>

<%= javascript_tag do %>
  ChecklistTree.initView();
<% end %>
<% end %>
